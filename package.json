{
    "name": "projektrack",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "lint": "eslint . --max-warnings=0 && node scripts/i18n/cli.ts",
        "lint:i18n": "node scripts/i18n/cli.ts",
        "lint:fix": "eslint . --fix && node scripts/i18n/cli.ts --fix",
        "format": "prettier --write resources/ \"modules/**/*.{ts,vue}\" scripts/ tests/e2e/ playwright.config.ts",
        "format:check": "prettier --check resources/ \"modules/**/*.{ts,vue}\" scripts/ tests/e2e/ playwright.config.ts",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@fontsource-variable/golos-text": "5.3.0",
        "@fontsource-variable/mona-sans": "5.3.0",
        "@fontsource-variable/noto-naskh-arabic": "5.3.0",
        "@fontsource-variable/vazirmatn": "5.3.0",
        "@inertiajs/vue3": "~3.11.0",
        "@lucide/vue": "^1.75.0",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "intl-messageformat": "12.1.4",
        "reka-ui": "~2.11.0",
        "tailwind-merge": "^3.2.0",
        "vue": "~3.5.45",
        "vue-input-otp": "^0.4.0",
        "vue-sonner": "^2.0.0"
    },
    "devDependencies": {
        "@formatjs/icu-messageformat-parser": "3.5.22",
        "@inertiajs/vite": "~3.11.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@playwright/test": "~1.65.1",
        "@tailwindcss/vite": "~4.3.5",
        "@types/node": "^24.0.0",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.6.0",
        "concurrently": "^10.0.3",
        "eslint": "10.15.0",
        "eslint-plugin-vue": "^10.12.1",
        "jsdom": "^31.0.1",
        "laravel-vite-plugin": "^3.2.1",
        "prettier": "3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "~4.3.5",
        "tw-animate-css": "^1.2.5",
        "typescript": "~6.0.3",
        "vite": "~8.3.8",
        "vitest": "~5.1.0",
        "vue-tsc": "^3.3.14"
    }
}
