# Plain hosting (Apache, MySQL or MariaDB, cron). Replace every CHANGE-ME.
APP_NAME=App
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Address of the installation, with https://
APP_URL=https://CHANGE-ME

APP_LOCALE=bs
APP_FALLBACK_LOCALE=en
I18N_LOCALES=bs,en

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# mysql or mariadb
DB_CONNECTION=mysql
DB_HOST=CHANGE-ME
DB_PORT=3306
DB_DATABASE=CHANGE-ME
DB_USERNAME=CHANGE-ME
DB_PASSWORD="CHANGE-ME"

# No Redis needed: everything below runs from the database and one cron entry.
SESSION_DRIVER=database
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# The setup link of the first administrator goes by mail.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=CHANGE-ME
MAIL_PORT=465
MAIL_USERNAME=CHANGE-ME
MAIL_PASSWORD="CHANGE-ME"
MAIL_FROM_ADDRESS=CHANGE-ME
MAIL_FROM_NAME=

# Only behind a reverse proxy that overwrites X-Forwarded-* headers.
# TRUSTED_PROXIES=
# HEALTH_ALLOWED_IPS=
DOCTOR_OPERATOR_TENANT=
