#
# Operations of a Docker Compose instance (S-0927), run on the host:
#
#   ./projektrack install --domain <host> --email <address> [--image <ref>]
#   ./projektrack backup
#   ./projektrack restore <backup folder name>
#   ./projektrack update <image>@sha256:<digest>
#
# update verifies the signature of the image, takes a backup and a snapshot,
# enables maintenance mode, migrates, starts the new version and checks its
# health. If any step fails, the snapshot is restored and the previous version
# runs again. Guide: docs/admin/docker.md.
set -Eeuo pipefail

cd "$(dirname "$0")"

IDENTITY='^https://github\.com/PROJEKTRA/projektrack/\.github/workflows/release\.yml@refs/tags/v[0-9]'
ISSUER='https://token.actions.githubusercontent.com'

log() { printf '%s projektrack: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }
fail() { log "$*"; exit 1; }
env_value() { sed -n "s/^$1=//p" .env | tail -n 1; }
dc() { docker compose "$@"; }
snapshot() { dc --profile update run --rm -T snapshot projektrack-snapshot "$1"; }

require_stack() { [[ -f .env ]] || fail 'There is no .env here; run "./projektrack install" first.'; }

# One operation at a time.
lock() {
    exec 9> .lock
    flock -n 9 || fail 'Another operation is running.'
}

healthy() {
    local _
    for _ in $(seq 1 60); do
        [[ "$(dc exec -T app wget -q -O - http://127.0.0.1:8080/health 2>/dev/null || true)" == 'OK' ]] && return 0
        sleep 2
    done
    return 1
}

# Waits for the container itself: in maintenance mode /health answers 503.
artisan_up() {
    local _
    for _ in $(seq 1 60); do
        dc exec -T app php artisan up >/dev/null 2>&1 && return 0
        sleep 2
    done
    return 1
}

version_of() {
    docker run --rm --network none --entrypoint php "$1" -r \
        'echo is_file("/app/VERSION") ? trim(file_get_contents("/app/VERSION")) : "0.9.0-dev";'
}

set_image() { sed -i "s|^PROJEKTRACK_IMAGE=.*|PROJEKTRACK_IMAGE=$1|" .env; }

install_stack() {
    ./setup.sh "$@"
    log 'Fill in the MAIL_ values in .env before you start the stack (docs/admin/docker.md).'
}

backup() {
    require_stack
    lock
    dc exec -T backup projektrack-backup run
}

restore() {
    require_stack
    lock
    dc up -d --wait db redis
    dc --profile restore run --rm -T restore restore "${1:-}"
    dc up -d
    healthy || fail 'The restored instance is not healthy.'
    log 'Restored.'
}

# Runs on every failure once the instance has been touched.
rollback() {
    trap - ERR INT TERM
    set +e
    log 'FAILED. Rolling back to the previous version.'
    dc stop proxy app worker scheduler backup >/dev/null 2>&1
    set_image "${old}"
    local ok=1
    if [[ "${restore_needed}" == 1 ]]; then
        snapshot restore || ok=0
    fi
    if [[ "${ok}" == 1 ]]; then
        dc up -d --no-deps app && artisan_up && healthy && dc up -d || ok=0
    fi
    if [[ "${ok}" != 1 ]]; then
        log 'ROLLBACK FAILED. The proxy is stopped and the snapshot is kept. See docs/admin/docker.md.'
        exit 2
    fi
    snapshot drop
    log 'Rolled back: the previous version runs again with its data.'
    exit 1
}

update() {
    require_stack
    lock
    new="${1:-}"
    old="$(env_value PROJEKTRACK_IMAGE)"
    restore_needed=0
    local repository
    repository="$(env_value PROJEKTRACK_REPOSITORY)"
    repository="${repository:-ghcr.io/projektra/projektrack}"

    [[ "${new}" == "${repository}@sha256:"* && "${new##*@sha256:}" =~ ^[0-9a-f]{64}$ ]] \
        || fail "Give the image by digest: ${repository}@sha256:<digest>."
    [[ -z "${PROJEKTRACK_IMAGE:-}" ]] || fail 'Unset PROJEKTRACK_IMAGE in your shell; it would override .env.'
    command -v cosign >/dev/null || fail 'cosign is not installed; the image cannot be verified.'

    log 'verifying the signature'
    cosign verify "${new}" --certificate-identity-regexp "${IDENTITY}" --certificate-oidc-issuer "${ISSUER}" >/dev/null \
        || fail 'The image is not signed by the release workflow. Nothing was changed.'
    docker pull -q "${new}" >/dev/null

    # An older genuine release must not pass as an update.
    local from to
    from="$(version_of "${old}")"
    to="$(version_of "${new}")"
    docker run --rm --network none --entrypoint php "${new}" -r \
        'exit(version_compare($argv[1], $argv[2], ">") ? 0 : 1);' "${to}" "${from}" \
        || fail "Version ${to} is not newer than ${from}. Nothing was changed."
    healthy || fail 'The instance is not healthy; fix that before an update.'

    log "updating ${from} to ${to}"
    dc exec -T backup projektrack-backup run

    trap rollback ERR INT TERM
    dc exec -T app php artisan down --retry=60
    dc stop worker scheduler backup
    snapshot create
    restore_needed=1

    # The app container keeps showing the maintenance page during migrations.
    PROJEKTRACK_IMAGE="${new}" dc run --rm -T migrate

    # Nobody writes before the new version is healthy: the proxy is stopped.
    dc stop proxy
    set_image "${new}"
    dc up -d --no-deps app
    artisan_up
    healthy
    dc up -d
    trap - ERR INT TERM
    snapshot drop
    log "Updated to ${to}."
}

case "${1:-}" in
    install) shift; install_stack "$@" ;;
    backup) backup ;;
    restore) shift; restore "$@" ;;
    update) shift; update "$@" ;;
    *) echo 'Usage: projektrack install|backup|restore|update (see the head of this file)' >&2; exit 2 ;;
esac
