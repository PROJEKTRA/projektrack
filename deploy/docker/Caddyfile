# Reverse proxy of the Docker Compose stack (S-0923, infrastructure profiles
# 8.3): automatic TLS, the mandatory headers on every response, no Server
# header. "?" sets a header only where the application did not, so its own
# values (nonce-based CSP, HSTS) stay. No access log: paths can carry tokens.

{
	{$CADDY_GLOBAL_OPTIONS}
	email {$ACME_EMAIL}
	admin off
	servers {
		protocols h1 h2 h3
	}
}

(projektrack_headers) {
	header {
		?X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate"
		?Referrer-Policy "no-referrer"
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		?Cross-Origin-Opener-Policy "same-origin"
		?Cross-Origin-Resource-Policy "same-origin"
		?Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		-Server
		-X-Powered-By
		defer
	}
}

# Plain HTTP only redirects, with the headers.
http://{$PROJEKTRACK_DOMAIN} {
	import projektrack_headers
	redir https://{host}{uri} 308
}

# Any other host name: the same plain 404 as an unknown path.
http:// {
	import projektrack_headers
	respond 404
}

{$PROJEKTRACK_DOMAIN} {
	import projektrack_headers

	# Only static files are compressed: compressed pages with secrets in them
	# could be guessed from their size (BREACH).
	@static path *.css *.js *.mjs *.map *.svg *.json *.webmanifest *.txt
	encode @static zstd gzip

	reverse_proxy app:8080
}
