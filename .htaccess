# Safety net for plain hosting: if the web root points here by mistake instead
# of public/, nothing is served. public/.htaccess allows its own folder again.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
