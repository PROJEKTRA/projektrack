# Technical name only (cache prefix); users see the brand (config/brand.php).
APP_NAME=App
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Default locale is Bosnian; fallback chain user, tenant, bs, en.
APP_LOCALE=bs
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Languages users and tenants can choose (config/i18n.php).
I18N_LOCALES=bs,en
# Pseudo-locales xx and xx-rtl for testing; default: on unless APP_ENV=production.
# I18N_PSEUDO=false

APP_MAINTENANCE_DRIVER=file

# Argon2id password hashing; lower only on hosts with little memory (minimum 19456 and 2).
# ARGON_MEMORY=65536
# ARGON_TIME=4
# "Remember me" duration in minutes (30 days).
# AUTH_REMEMBER_MINUTES=43200
# Breached-password check, an outside request (off by default).
# AUTH_PASSWORD_BREACH_CHECK=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite. CI tests MySQL 8.4, MariaDB 11.4 and PostgreSQL 16.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=projektrack
# DB_USERNAME=projektrack
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Neutral cookie name: no framework or product fingerprint before login.
# Session cookie: Secure and named __Host-sid when APP_URL is https, else sid.
# SESSION_SECURE_COOKIE=true
# Absolute session lifetime in minutes (idle timeout: SESSION_LIFETIME).
# SESSION_ABSOLUTE_LIFETIME=720
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Plain hosting profile: the database queue runs from cron.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Health check: GET /health answers OK. Limit who may ask (addresses or CIDR ranges).
# Behind a reverse proxy, also set the trusted proxies, or every request seems to come from the proxy.
# HEALTH_ALLOWED_IPS=10.0.0.0/8
